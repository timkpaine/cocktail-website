{
	"name": "barrelcocktail.co",
	"version": "0.1.0",
	"description": "Website for Barrel Cocktail Co.",
	"packageManager": "pnpm@11.28.0",
	"engines": {
		"node": ">=22.17"
	},
	"type": "module",
	"private": true,
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "rm -rf ./tmp-repo && git clone -b gh-pages git@github.com:timkpaine/cocktail-website.git ./tmp-repo && rm -rf ./tmp-repo/* && cp -r build/. ./tmp-repo && cd ./tmp-repo && git add . && git commit -m 'autoupdate docs' && git push",
		"dev": "vite dev",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"test": "pnpm run test:integration && pnpm run test:unit",
		"test:integration": "playwright test",
		"test:unit": "vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/eslint": "^9.6.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.5"
	}
}
