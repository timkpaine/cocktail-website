{
	"extends": "$app/tsconfig",
	"include": ["src", "tests", "*"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler"
	}
}
